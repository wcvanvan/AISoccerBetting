{
  "version": 2,
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node" },
    { "src": "api/debug.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/debug", "dest": "/api/debug.ts" },
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ],
  "env": {
    "READONLY_MODE": "1",
    "NODE_ENV": "production"
  }
}
