{
  "name": "soccer-betting-analyzer",
  "version": "2.0.0",
  "description": "Soccer betting prediction pipeline — collects match data, fetches live odds, and uses Claude to produce structured value picks with post-game reviews",
  "scripts": {
    "build": "ts-node scripts/build-web.ts",
    "web": "ts-node scripts/build-web.ts --serve",
    "vercel-build": "npm run build",

    "corners:predict": "ts-node src/cli-corners.ts --predict-pipeline",
    "corners:review": "ts-node src/cli-corners.ts --review-pipeline",
    "corners:data-stage": "ts-node src/cli-corners.ts",
    "corners:news-stage": "ts-node src/cli-corners.ts --news",
    "corners:odds-stage": "ts-node src/cli-corners.ts --agent-odds",
    "corners:predict-stage": "ts-node src/cli-corners.ts --predict",
    "corners:results-stage": "ts-node src/cli-corners.ts --results",
    "corners:review-stage": "ts-node src/cli-corners.ts --review",

    "goals:predict": "ts-node src/cli-goals.ts --predict-pipeline",
    "goals:review": "ts-node src/cli-goals.ts --review-pipeline",
    "goals:data-stage": "ts-node src/cli-goals.ts",
    "goals:news-stage": "ts-node src/cli-goals.ts --news",
    "goals:odds-stage": "ts-node src/cli-goals.ts --agent-odds",
    "goals:predict-stage": "ts-node src/cli-goals.ts --predict",
    "goals:results-stage": "ts-node src/cli-goals.ts --results",
    "goals:review-stage": "ts-node src/cli-goals.ts --review",

    "cards:predict": "ts-node src/cli-cards.ts --predict-pipeline",
    "cards:review": "ts-node src/cli-cards.ts --review-pipeline",
    "cards:data-stage": "ts-node src/cli-cards.ts",
    "cards:news-stage": "ts-node src/cli-cards.ts --news",
    "cards:odds-stage": "ts-node src/cli-cards.ts --agent-odds",
    "cards:predict-stage": "ts-node src/cli-cards.ts --predict",
    "cards:results-stage": "ts-node src/cli-cards.ts --results",
    "cards:review-stage": "ts-node src/cli-cards.ts --review"
  },
  "keywords": [
    "soccer",
    "betting",
    "claude",
    "corners",
    "goals",
    "cards",
    "xG"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "dotenv": "^17.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "@upstash/redis": "^1.37.0",
    "marked": "^17.0.4",
    "vercel": "^50.33.0"
  }
}
