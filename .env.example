# ─────────────────────────────────────────────────────────────
# .env.example — template for your local .env (git-ignored)
#
# Non-secret defaults are already set in .env.defaults.
# Only put secret keys and personal overrides in .env.
# ─────────────────────────────────────────────────────────────

# Anthropic API key (required when enabling news fetching or data analysis).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Tavily API key for web search (required when MATCH_NEWS_FETCHING is enabled).
# Free tier available at app.tavily.com
TAVILY_API_KEY=your-tavily-api-key

# The Odds API key for betting odds collection (corners, goals, cards).
# Get a key at https://the-odds-api.com (free tier available).
# If not set, odds collection is silently skipped.
THE_ODDS_API_KEY=your-the-odds-api-key

# Web UI authentication (required for npm run web)
# usernames are "admin" and "reader"
WEB_ADMIN_PASSWORD=changeme
WEB_READER_PASSWORD=changeme
