# ─────────────────────────────────────────────────────────────
# .env.example — template for your local .env (git-ignored)
#
# Non-secret defaults are already set in .env.defaults.
# Only put secret keys and personal overrides in .env.
# ─────────────────────────────────────────────────────────────

# The Odds API key for betting odds collection (corners, goals, cards).
# Get a key at https://the-odds-api.com (free tier available).
# If not set, odds collection is silently skipped.
THE_ODDS_API_KEY=your-the-odds-api-key
