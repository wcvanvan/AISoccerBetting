# ─────────────────────────────────────────────────────────────
# .env.example — template for your local .env (git-ignored)
#
# Non-secret defaults are already set in .env.defaults.
# Only put secret keys and personal overrides in .env.
# ─────────────────────────────────────────────────────────────

# Anthropic API key (required when MATCH_NEWS_FETCHING is enabled).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Tavily API key for web search (required when MATCH_NEWS_FETCHING is enabled).
# Free tier available at app.tavily.com
TAVILY_API_KEY=your-tavily-api-key