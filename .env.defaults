# Shared non-secret defaults — committed to git.
# Override any value by setting it in your local .env (which is git-ignored).

# LLM mode for analysis: "cli" uses `claude --print` (free with CLI subscription),
# "api" uses LangChain + Claude API (requires CLAUDE_API_KEY).
# News fetching uses Claude Code CLI with built-in web search.
LLM_MODE=cli

MATCH_NEWS_FETCHING=false
# Claude model for match news web search agent (via Claude Code CLI)
WEB_SEARCH_MODEL=claude-opus-4-6

# Betting analysis (Opus + extended thinking on the completed report)
# Works for all markets: corners, goals, cards
ANALYSIS_ENABLED=false
ANALYSIS_MODEL=claude-opus-4-6
ANALYSIS_TIMEOUT=1200
# Total output token budget (includes both thinking + visible output).
# Thinking gets ANALYSIS_THINKING_BUDGET; the remainder is visible analysis.
ANALYSIS_MAX_TOKENS=32768
# Internal reasoning budget (subset of ANALYSIS_MAX_TOKENS).
# Set to 0 to disable extended thinking.
ANALYSIS_THINKING_BUDGET=10000

# The Odds API: soccer sport keys to search (see https://the-odds-api.com/liveapi/guides/v4/#supported-sport)
ODDS_SPORT_KEYS=soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_fa_cup,soccer_england_efl_cup

# Bookmakers to include in odds results (overrides ODDS_REGIONS when set)
ODDS_BOOKMAKERS=fanduel,draftkings

# Fallback regions if ODDS_BOOKMAKERS is not set
ODDS_REGIONS=eu,us

# soccerdata bridge: set to 1 to bypass ESPN cache and force fresh fetches
# SOCCERDATA_NO_CACHE=1

# Session cookie signing secret (required in production, random fallback in dev)
# SESSION_SECRET=
